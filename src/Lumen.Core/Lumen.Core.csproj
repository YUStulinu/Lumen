<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Lumen.Core contains everything that does not depend on a UI framework:
    chat models, prompt templates, the two LLM backends (local ONNX + Claude),
    the router that decides between them, and the settings model.
    Keeping it UI-free lets the test project exercise it on any machine.
  -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>Lumen.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="12.53.0" />
    <PackageReference Include="Microsoft.ML.OnnxRuntimeGenAI" Version="0.17.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Lumen.Core.Tests" />
  </ItemGroup>

</Project>
