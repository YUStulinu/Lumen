<Window x:Class="Lumen.App.Views.AssistantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Lumen.App.ViewModels"
        xmlns:prompts="clr-namespace:Lumen.Core.Prompts;assembly=Lumen.Core"
        xmlns:controls="clr-namespace:Lumen.App.Controls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:AssistantViewModel}"
        Title="Lumen"
        Icon="/Assets/lumen.ico"
        Width="620" Height="700" MinWidth="440" MinHeight="420"
        WindowStartupLocation="Manual"
        ShowInTaskbar="True"
        UseLayoutRounding="True">

    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding NewConversationCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+C" Command="{Binding CopyAnswerCommand}" />
        <KeyBinding Gesture="Ctrl+R" Command="{Binding PasteAnswerCommand}" />
    </Window.InputBindings>

    <Grid Margin="14,10,14,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- header -->
            <RowDefinition Height="Auto" />  <!-- captured content -->
            <RowDefinition Height="Auto" />  <!-- quick actions -->
            <RowDefinition Height="*" />     <!-- conversation -->
            <RowDefinition Height="Auto" />  <!-- input -->
            <RowDefinition Height="Auto" />  <!-- status bar -->
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="True">
            <Image Source="/Assets/lumen.ico" Width="22" Height="22" Margin="0,0,8,0" DockPanel.Dock="Left" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button ToolTip="New conversation (Ctrl+N)" Command="{Binding NewConversationCommand}" Padding="8,4" Margin="4,0,0,0">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE710;" />
                </Button>
                <Button x:Name="SettingsButton" ToolTip="Settings" Click="OnSettingsClick" Padding="8,4" Margin="4,0,0,0">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE713;" />
                </Button>
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Lumen" FontSize="15" FontWeight="SemiBold" />
                <TextBlock Text="{Binding SourceLabel}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DockPanel>

        <!-- ===== Captured text (editable) + screenshot thumbnail ===== -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Margin="0,0,8,0" CornerRadius="4" ClipToBounds="True"
                        Visibility="{Binding ScreenshotPreview, Converter={StaticResource NullToVisibility}}">
                    <Image Source="{Binding ScreenshotPreview}" MaxWidth="140" MaxHeight="110" Stretch="Uniform" />
                </Border>
                <Grid Grid.Column="1">
                    <TextBox x:Name="CapturedBox"
                             Text="{Binding CapturedText, UpdateSourceTrigger=PropertyChanged}"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             MinHeight="56" MaxHeight="150"
                             VerticalScrollBarVisibility="Auto"
                             FontSize="13" />
                    <TextBlock Text="Selected text appears here. You can also paste or type text to work on."
                               IsHitTestVisible="False" Margin="12,8,0,0" FontSize="13"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Visibility="{Binding CapturedText, Converter={StaticResource StringToVisibility}, ConverterParameter=invert}"
                               x:Name="CapturedPlaceholder" />
                </Grid>
            </Grid>
        </Border>

        <!-- ===== Quick actions ===== -->
        <ItemsControl Grid.Row="2" ItemsSource="{Binding QuickActions}" Margin="0,0,0,6" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type prompts:QuickAction}">
                    <Button Margin="0,0,6,6" Padding="10,5"
                            Command="{Binding DataContext.RunActionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            ToolTip="{Binding Instruction}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="{Binding Icon}" FontSize="13" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ===== Conversation ===== -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <ScrollViewer x:Name="ConversationScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              ScrollChanged="OnConversationScrollChanged" PreviewMouseWheel="OnConversationMouseWheel" Padding="12,8">
                    <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ChatItemViewModel}">
                                <ContentControl Content="{Binding}" Focusable="False">
                                    <ContentControl.Style>
                                        <Style TargetType="ContentControl">
                                            <!-- Assistant message (default) -->
                                            <Setter Property="ContentTemplate">
                                                <Setter.Value>
                                                    <DataTemplate>
                                                        <StackPanel Margin="0,4,0,12">
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                                <TextBlock Style="{StaticResource IconText}" Text="&#xE945;" FontSize="12"
                                                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,6,0" />
                                                                <TextBlock Text="{Binding BackendLabel, Converter={StaticResource EmptyLabel}, ConverterParameter=Lumen, TargetNullValue=Lumen}"
                                                                           FontSize="12" FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Notice}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4"
                                                                       Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                                       Visibility="{Binding Notice, Converter={StaticResource StringToVisibility}}" />
                                                            <ProgressBar IsIndeterminate="True" Height="3" Width="120" HorizontalAlignment="Left" Margin="0,6,0,6">
                                                                <ProgressBar.Visibility>
                                                                    <MultiBinding Converter="{x:Static controls:StreamingIndicator.Converter}">
                                                                        <Binding Path="IsStreaming" />
                                                                        <Binding Path="Text" />
                                                                    </MultiBinding>
                                                                </ProgressBar.Visibility>
                                                            </ProgressBar>
                                                            <RichTextBox Style="{StaticResource MarkdownBox}"
                                                                         controls:MarkdownRender.Markdown="{Binding Text}"
                                                                         Visibility="{Binding IsError, Converter={StaticResource InverseBoolToVisibility}}" />
                                                            <Border Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}" CornerRadius="6" Padding="10,8"
                                                                    Visibility="{Binding IsError, Converter={StaticResource BoolToVisibility}}">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Style="{StaticResource IconText}" Text="&#xEA39;" Margin="0,0,8,0"
                                                                               Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                                                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" MaxWidth="480" />
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <!-- User message: a bubble on the right -->
                                                <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                    <Setter Property="ContentTemplate">
                                                        <Setter.Value>
                                                            <DataTemplate>
                                                                <Border HorizontalAlignment="Right" MaxWidth="440" Margin="40,4,0,10" Padding="12,7" CornerRadius="10"
                                                                        Background="{DynamicResource AccentFillColorDefaultBrush}">
                                                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                                                               Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContentControl.Style>
                                </ContentControl>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Empty state -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24" IsHitTestVisible="False"
                            Visibility="{Binding HasConversation, Converter={StaticResource InverseBoolToVisibility}}">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE945;" FontSize="32" HorizontalAlignment="Center"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,0,10" />
                    <TextBlock Text="Pick an action above or type a question below." HorizontalAlignment="Center" FontSize="14" />
                    <TextBlock HorizontalAlignment="Center" TextAlignment="Center" Margin="0,6,0,0" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="Ctrl+1…9 runs an action · Enter sends · Shift+Enter adds a new line · Esc hides" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Input ===== -->
        <Grid Grid.Row="4" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="InputBox" Grid.Column="0"
                     Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="False" TextWrapping="Wrap" MaxHeight="120" VerticalScrollBarVisibility="Auto"
                     PreviewKeyDown="OnInputPreviewKeyDown" FontSize="14" />
            <TextBlock Grid.Column="0" IsHitTestVisible="False" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="14"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Ask anything, or a follow-up…"
                       Visibility="{Binding Input, Converter={StaticResource StringToVisibility}, ConverterParameter=invert}"
                       x:Name="InputPlaceholder" />
            <Button Grid.Column="1" Margin="6,0,0,0" Padding="12,6" Style="{DynamicResource AccentButtonStyle}"
                    Command="{Binding SendCommand}" ToolTip="Send (Enter)"
                    Visibility="{Binding IsBusy, Converter={StaticResource InverseBoolToVisibility}}">
                <TextBlock Style="{StaticResource IconText}" Text="&#xE724;" />
            </Button>
            <Button Grid.Column="1" Margin="6,0,0,0" Padding="12,6"
                    Command="{Binding StopCommand}" ToolTip="Stop (Esc)"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Style="{StaticResource IconText}" Text="&#xE71A;" />
            </Button>
        </Grid>

        <!-- ===== Status bar ===== -->
        <DockPanel Grid.Row="5" Margin="0,8,0,0" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Command="{Binding CopyAnswerCommand}" Padding="10,4" ToolTip="Copy the answer (Ctrl+Shift+C)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE8C8;" FontSize="12" Margin="0,0,6,0" />
                        <TextBlock Text="Copy" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding PasteAnswerCommand}" Padding="10,4" Margin="6,0,0,0"
                        ToolTip="Replace the original selection with the answer (Ctrl+R)"
                        Visibility="{Binding CanPasteBack, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE77F;" FontSize="12" Margin="0,0,6,0" />
                        <TextBlock Text="Replace selection" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBlock Text="{Binding Status}" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </DockPanel>
    </Grid>
</Window>
