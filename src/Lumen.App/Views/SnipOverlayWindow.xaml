<Window x:Class="Lumen.App.Views.SnipOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lumen - select a region"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Black"
        Cursor="Cross"
        UseLayoutRounding="True">
    <Grid x:Name="Root">
        <!-- The frozen screenshot. Stretch=Fill maps it 1:1 onto the monitor whatever the DPI scale. -->
        <Image x:Name="Screenshot" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />

        <!-- Everything except the selection is dimmed: a full-screen rectangle minus the selection rectangle. -->
        <Path x:Name="Dim" Fill="#99000000" IsHitTestVisible="False" />

        <Rectangle x:Name="SelectionBorder"
                   HorizontalAlignment="Left" VerticalAlignment="Top"
                   Stroke="#A855F7" StrokeThickness="2"
                   Visibility="Collapsed" IsHitTestVisible="False" />

        <Border x:Name="SizeLabel"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Background="#E61E1B2E" CornerRadius="4" Padding="6,2"
                Visibility="Collapsed" IsHitTestVisible="False">
            <TextBlock x:Name="SizeText" Foreground="White" FontSize="12" FontFamily="Segoe UI" />
        </Border>

        <Border x:Name="Hint"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,48,0,0"
                Background="#E61E1B2E" CornerRadius="8" Padding="16,10" IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE7C5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                           Foreground="#C4B5FD" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Foreground="White" FontSize="14" FontFamily="Segoe UI" VerticalAlignment="Center"
                           Text="Drag to select the text to read  ·  Esc or right-click to cancel" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
