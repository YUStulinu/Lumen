<Project>
  <!--
    Settings shared by every project in the solution.
    MSBuild automatically imports this file for any project located below this folder.
  -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- CA1848/CA1873 (LoggerMessage delegates) are noisy for a desktop app with a handful of log calls. -->
    <!-- CA2007 (ConfigureAwait) does not apply to UI code, where we want to resume on the UI thread. -->
    <NoWarn>$(NoWarn);CA1848;CA1873;CA2007;CA1031;CA1303;CA1805;CA1515;CA1711;CA1716</NoWarn>

    <Product>Lumen</Product>
    <Company>Lumen</Company>
    <Authors>Iustin Prodan</Authors>
    <Copyright>Copyright (c) 2026 Iustin Prodan</Copyright>
    <Version>1.0.0</Version>
  </PropertyGroup>
</Project>
